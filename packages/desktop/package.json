{
    "name": "cith-desktop",
    "version": "0.10.0",
    "private": true,
    "description": "Cith desktop client — Electron + React chat UI speaking WebSocket to the core",
    "author": "chail",
    "type": "module",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "dev:web": "vite --config vite.renderer.config.ts",
        "build": "tsc -b && electron-vite build",
        "preview": "electron-vite preview",
        "dist": "tsc -b && electron-vite build && electron-builder",
        "dist:dir": "tsc -b && electron-vite build && electron-builder --dir",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
    },
    "dependencies": {
        "@cith/ui": "*",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "electron-updater": "^6.8.12",
        "qrcode": "^1.5.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tar": "^7.5.23"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.3.0",
        "electron": "45.3.2",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.8"
    },
    "build": {
        "appId": "dev.sunbatwo.cith",
        "productName": "Cith",
        "publish": {
            "provider": "github",
            "owner": "chail233",
            "repo": "Cith",
            "tagNamePrefix": "desktop-v"
        },
        "directories": {
            "output": "release"
        },
        "files": [
            "out/**",
            "resources/**"
        ],
        "extraResources": [
            {
                "from": "core-bundle",
                "to": "core",
                "filter": [
                    "**/*",
                    "!node_modules/**"
                ]
            }
        ],
        "win": {
            "icon": "build/icon.ico",
            "target": [
                "nsis",
                "portable"
            ]
        },
        "nsis": {
            "artifactName": "Cith-Setup-${version}-${arch}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "portable": {
            "artifactName": "Cith-Portable-${version}-${arch}.${ext}"
        }
    }
}
