{
  "compilerOptions": {
    // 运行环境为 Node 24 + ESM（package.json type: "module"）
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    // 编译目录与输出目录：src 下所有源码编译输出到 dist
    "rootDir": "src",
    "outDir": "dist",

    // 项目主体为 JS，逐步引入 TS：允许编译 .js，但不检查 .js 类型
    "allowJs": true,
    "checkJs": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,

    // 允许在 import 路径中写 .ts 后缀（开发时 Node 24 直接跑源码需要）
    "allowImportingTsExtensions": true,
    // 构建输出时把相对导入的 .ts 后缀重写为 .js，保证 dist 可运行
    "rewriteRelativeImportExtensions": true,
    // 只允许可擦除的 TS 语法（不用 enum/参数属性等），保证 Node 原生 type stripping 兼容
    "erasableSyntaxOnly": true,

    // 本配置为类型检查/IDE 基准配置：不产出文件，实时检查 .ts
    // 构建走 tsconfig.build.json（noCheck 只转译，放过遗留 JS）
    "noEmit": true,
    "removeComments": true
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/workspace"]
}
