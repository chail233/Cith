#web 后端（BFF）监听窗口
WEB_PORT = 2146

#HTTPS 自签名证书开关（true 启用 https，false/不填维持 http；启用后通过 https://<IP>:WEB_PORT 访问，
#首次访问浏览器会提示自签名证书，信任后即可正常使用）
WEB_SSL_ENABLED = false
#写入证书 subjectAltName 的公网 IP（留空则 SAN 仅含 localhost/127.0.0.1）
WEB_SERVER_IP = 

#控制台登录密码（浏览器登录BFF用）
WEB_PASSWORD = change-me

#Bot面板 API（WebSocket）
BOT_API_URL = ws://127.0.0.1:2145/api/v1/ws
BOT_API_TOKEN = 114514