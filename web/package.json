{
    "name": "sunbatwobot-web",
    "version": "0.1.0",
    "private": false,
    "description": "SunbatwoBot's web dashboard (React + Vite frontend, Express backend)",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "server": "node --env-file-if-exists=.env server/index.mjs",
        "server:watch": "node --env-file-if-exists=.env --watch server/index.mjs",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit"
    },
    "author": "alinger158",
    "dependencies": {
        "express": "^5.3.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^4.3.4",
        "typescript": "^5.6.3",
        "vite": "^5.4.11"
    }
}
