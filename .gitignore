# 用户配置层（含真实密钥，不入库；生产可放仓库外并用 CITH_CONFIG 指向）
/core/config.json
/core/config.json.tmp

# 旧版配置层：机制已废弃，仅保留忽略规则以免残留文件被误提交
/core/configDev.js
/core/configOverride.json
/core/configOverride.json.tmp
/core/app.pem
/secrets/

*.pem
/mcp/

/node_modules/
/dist/
/core/stickers/manifest.dev.json

# 提示词面板保存时产生的备份与临时文件
/core/prompts/*.bak
/core/prompts/*.tmp

# 长期记忆数据（rememori append-only 文件）
/core/data/rememori/

# 微信图片落地（图像识别用的临时缓存）
/core/data/images/

# 入站语音落地（QQ 语音转码后的 mp3）
/core/data/voices/

# 微信登录凭证（wechatStorageDir 指向仓库内目录时）
/core/data/wechatbot*/

# 全局笔记（AI 自我维护，运行时懒创建）
/core/data/notes.json
/core/data/notes.json.tmp
