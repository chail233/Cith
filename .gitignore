# 用户配置层（含真实密钥，不入库；生产可放仓库外并用 CITH_CONFIG 指向）
/packages/core/config.json
/packages/core/config.json.tmp

# 旧版配置层：机制已废弃，仅保留忽略规则以免残留文件被误提交
/packages/core/configDev.js
/packages/core/configOverride.json
/packages/core/configOverride.json.tmp
/packages/core/app.pem
/secrets/

*.pem
/mcp/

/node_modules/
/dist/
/packages/core/stickers/manifest.dev.json

# 提示词面板保存时产生的备份与临时文件
/packages/core/prompts/*.bak
/packages/core/prompts/*.tmp

# 长期记忆数据（rememori append-only 文件）
/packages/core/data/rememori/

# 微信图片落地（图像识别用的临时缓存）
/packages/core/data/images/

# 入站语音落地（QQ 语音转码后的 mp3）
/packages/core/data/voices/

# 语音 MCP server 的数据（tts 生成的 mp3 + 默认音色记录）
/voice-data/

# 微信登录凭证（wechatStorageDir 指向仓库内目录时）
/packages/core/data/wechatbot*/
# 微信登录凭证与会话令牌（仓库根目录的历史落点）
/.wechatbot/

# 全局笔记（AI 自我维护，运行时懒创建）
/packages/core/data/notes.json
/packages/core/data/notes.json.tmp

# token-usage 运行数据（与 data 路径问题一族，待统一治理）
/packages/core/data/token-usage.json

# IDE 本地配置（仅跟踪 .idea/.gitignore 这一个忽略清单）
/.idea/

# 本地 AI 计划文件
/.zcode/
