{
  "name": "sunbatwobot",
  "version": "1.2.0",
  "description": "A Personal Agent with any adapter you want, featuring multi-turn tool calling, a four-tier memory system, user profiling, image vision, MCP tool extensions and a pluggable skill system.",
  "workspaces": ["packages/*"],
  "scripts": {
    "setup": "node scripts/setup.ts",
    "start": "node packages/core/index.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "build:web": "npm run build -w packages/web",
    "build:desktop": "npm run build -w packages/desktop",
    "build:all": "npm run build && npm run build:web",
    "start:dist": "node dist/index.js",
    "test": "node --experimental-test-module-mocks --test \"tests/**/*.test.mjs\"",
    "bench:thresholds": "node --experimental-test-module-mocks --test tests/thresholds.test.mjs",
    "add-stickers": "node scripts/add-stickers.js"
  },
  "private": false,
  "keywords": [
    "onebot11",
    "napcat",
    "qq‑bot",
    "agent",
    "ai",
    "chat"
  ],
  "author": "chail233",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "octokit": "^5.0.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
