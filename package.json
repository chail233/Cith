{
  "name": "cith",
  "version": "1.2.1",
  "description": "A self-hosted personal agent living in QQ, WeChat and its own desktop client — multi-turn tool calling, layered memory, MCP tools and a pluggable skill system.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.ts",
    "start": "node packages/core/index.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "build:web": "npm run build -w packages/web",
    "build:desktop": "npm run build -w packages/desktop",
    "bundle:desktop": "npm run build && node scripts/stage-desktop-core.js && npm run dist -w packages/desktop --",
    "build:all": "npm run build && npm run build:web",
    "start:dist": "node dist/index.js",
    "test": "node --experimental-test-module-mocks --test \"tests/**/*.test.mjs\"",
    "add-stickers": "node scripts/add-stickers.js"
  },
  "private": false,
  "keywords": [
    "onebot11",
    "napcat",
    "qq‑bot",
    "agent",
    "ai",
    "chat"
  ],
  "author": "chail233",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "octokit": "^5.0.5",
    "tar": "^7.5.23",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
