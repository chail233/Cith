{
  "name": "sunbatwobot",
  "version": "1.1.0",
  "description": "A OneBot11 QQ bot based on NapCat, supports LLM conversation, image vision capability and custom message processing.",
  "scripts": {
    "start": "node src/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start:dist": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "private": false,
  "keywords": [
    "onebot11",
    "napcat",
    "qq‑bot"
  ],
  "author": "chail233",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "node-schedule": "^2.1.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "octokit": "^5.0.5",
    "zod": "^4.6.5"
  }
}
