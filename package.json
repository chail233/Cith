{
  "name": "sunbatwobot",
  "version": "1.1.0",
  "description": "An autonomous LLM Agent QQ bot built on OneBot v11 + NapCat, featuring multi-turn tool calling, a four-tier memory system, user profiling, image vision, MCP tool extensions and a pluggable skill system.",
  "scripts": {
    "start": "node core/index.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start:dist": "node dist/index.js"
  },
  "private": false,
  "keywords": [
    "onebot11",
    "napcat",
    "qq‑bot"
  ],
  "author": "chail233",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "node-schedule": "^2.1.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "octokit": "^5.0.5",
    "zod": "^4.6.5"
  }
}
